  "fields": {
    "id":{"type":"string","default":"","max":40},
    "name":{"type":"string","default":"","max":120},
    "enabled":{"type":"boolean","default":true},
    "trigger":{"type":"string","default":"click","max":40},
    "action":{"type":"string","default":"toggle","max":40},
    "targetMode":{"type":"string","default":"self","max":20},
    "targetValue":{"type":"string","default":"","max":500},
    "delay":{"label":"Delay (ms)","type":"number","default":0,"min":0,"max":600000},
    "cooldown":{"label":"Cooldown (ms)","type":"number","default":0,"min":0,"max":600000},
    "once":{"type":"boolean","default":false},
    "preventDefault":{"type":"boolean","default":false},
    "stopPropagation":{"type":"boolean","default":false},
    "key":{"label":"Key","type":"string","default":"Enter","max":40,"placeholder":"Enter, Escape, ArrowDown…"},
    "eventName":{"label":"Event name","type":"string","default":"","max":100,"placeholder":"my-site:ready"},
    "eventScope":{"label":"Listen on","type":"select","default":"element","options":{"element":"This element and descendants","document":"Document","window":"Window"}},
    "afterId":{"label":"Interaction ID","type":"string","default":"","max":40,"placeholder":"li_…"},
    "timelineId":{"label":"Motion timeline","type":"string","default":"","max":40,"placeholder":"Choose a timeline…"},
    "threshold":{"label":"Visible amount (%)","type":"number","default":0,"min":0,"max":100},
    "rootMargin":{"label":"Viewport margin","type":"string","default":"0px","max":100,"placeholder":"0px 0px -10% 0px"},
    "scrollOffset":{"label":"Scroll position","type":"number","default":100,"min":0,"max":1000000},
    "scrollUnit":{"label":"Scroll unit","type":"select","default":"px","options":{"px":"Pixels","%":"Scrollable page (%)","vh":"Viewport height (vh)"}},
    "scrollDirection":{"label":"Crossing direction","type":"select","default":"down","options":{"down":"Downwards","up":"Upwards","both":"Both directions"}},
    "className":{"label":"Class names","type":"string","default":"","max":500,"placeholder":"is-active is-expanded"},
    "attribute":{"label":"Attribute name","type":"string","default":"","max":100,"placeholder":"aria-expanded"},
    "value":{"label":"Value","type":"string","default":"","max":2000,"placeholder":"Value to apply or store"},
    "property":{"label":"CSS property","type":"string","default":"","max":100,"placeholder":"opacity, background-color, --accent…"},
    "animation":{"label":"Animation","type":"select","default":"fade-in","options":{"fade-in":"Fade in","fade-out":"Fade out","rise":"Rise in","fall":"Fall in","slide-left":"Slide from left","slide-right":"Slide from right","zoom-in":"Zoom in","zoom-out":"Zoom out","pulse":"Pulse","shake":"Shake"}},
    "duration":{"label":"Duration (ms)","type":"number","default":300,"min":0,"max":60000},
    "easing":{"label":"Easing","type":"select","default":"ease-out","options":{"linear":"Linear","ease":"Ease","ease-in":"Ease in","ease-out":"Ease out","ease-in-out":"Ease in/out"}},
    "offset":{"label":"Scroll offset (px)","type":"number","default":0,"min":-100000,"max":100000},
    "smooth":{"type":"boolean","default":true},
    "url":{"label":"Destination URL","type":"string","default":"","max":2000,"placeholder":"/contact/ or https://example.com"},
    "step":{"label":"Checkout step ID","type":"string","default":"","max":100,"placeholder":"Step ID configured on your checkout"},
    "colorMode":{"label":"Color mode","type":"select","default":"toggle","options":{"toggle":"Toggle light / dark","light":"Light","dark":"Dark"}},
    "storage":{"label":"Storage","type":"select","default":"session","options":{"memory":"Current page","session":"Browser session","local":"Local storage"}},
    "storageKey":{"label":"Storage key","type":"string","default":"","max":100,"placeholder":"notice-dismissed"},
    "amount":{"label":"Increment by","type":"number","default":1,"min":-1000000,"max":1000000},
    "functionName":{"label":"Function name","type":"string","default":"","max":120,"placeholder":"mySite.openPanel"},
    "arguments":{"label":"JSON arguments / event detail","type":"string","default":"[]","max":6000,"placeholder":"[\"hello\", 42] or {\"source\": \"menu\"}"},
    "minWidth":{"label":"Minimum viewport (px)","type":"string","default":"","max":6,"placeholder":"All widths"},
    "maxWidth":{"label":"Maximum viewport (px)","type":"string","default":"","max":6,"placeholder":"All widths"},
    "relation":{"label":"Condition matching","type":"select","default":"all","options":{"all":"All conditions must match","any":"Any condition may match"}}
  }
